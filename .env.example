# Copy to .env for local configuration. Never commit real API keys.
SECURESUPPORT_ENVIRONMENT=development
SECURESUPPORT_DEBUG=false
SECURESUPPORT_OPENAI_API_KEY=

SECURESUPPORT_EMBEDDING_MODEL=text-embedding-3-small
SECURESUPPORT_CHROMA_PATH=data/chroma
SECURESUPPORT_CHAT_MODEL=gpt-4.1-mini
SECURESUPPORT_DATABASE_PATH=data/support.sqlite3

# Retrieval policy. The distance ceiling is opt-in because cosine distance is not
# a calibrated relevance probability; tune it per corpus, or leave it blank.
SECURESUPPORT_RETRIEVAL_TOP_K=3
SECURESUPPORT_RETRIEVAL_MAX_DISTANCE=

# Bounded conversation history passed to the model per request.
SECURESUPPORT_MAX_HISTORY_TURNS=6

# Explicit USD price per million tokens. Leave blank and traces report cost as
# unknown instead of guessing a price table that can silently go stale.
SECURESUPPORT_INPUT_COST_PER_MILLION_USD=
SECURESUPPORT_OUTPUT_COST_PER_MILLION_USD=

# One structured JSON trace line per request (no message text or record payloads).
SECURESUPPORT_TRACE_LOG_ENABLED=true
